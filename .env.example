# Application Environment
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Default Location
DEFAULT_CITY=Delhi
DEFAULT_COUNTRY=India
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
TIMEZONE=UTC

# Data Provider Configuration
DATA_PROVIDER=mock

# AQICN API (https://aqicn.org/data-platform/token/)
AQICN_TOKEN=
AQICN_STATION=

# OpenWeather API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_LATITUDE=
OPENWEATHER_LONGITUDE=

# Feature Store Configuration
FEATURE_STORE_BACKEND=local
FEATURE_STORE_PATH=data/features

# Model Registry
MODEL_REGISTRY_PATH=data/models

# Data Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
REPORTS_PATH=data/reports

# Forecasting Configuration
FORECAST_HORIZON_DAYS=3

# Alert Thresholds (US EPA AQI Scale)
POLLUTION_ALERT_AQI=150
HAZARDOUS_AQI=300

# Training Configuration
MIN_TRAINING_ROWS=168
TRAIN_TEST_SPLIT=0.70
VALIDATION_SPLIT=0.15
TEST_SPLIT=0.15

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Dashboard Configuration
DASHBOARD_PORT=8501

# Request Configuration
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF=2
